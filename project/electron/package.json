{
  "name": "quki-electron",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop wrapper for QuKi Notes: hosts NodeFsBackend in the main process and serves the existing web app renderer unchanged, over IPC.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "tsc -b && electron dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "quki-core": "file:../core"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
